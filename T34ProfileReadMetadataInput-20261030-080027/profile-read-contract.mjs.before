const SAFE_ERROR_NAMES = new Set([
  'Error',
  'TypeError',
  'RangeError',
  'SyntaxError',
  'AssertionError',
])

const SAFE_ERROR_CODES = new Set([
  'PROFILE_READ_VALIDATION',
  'ERR_ASSERTION',
  'ERR_MODULE_NOT_FOUND',
  'ENOENT',
  'EACCES',
  'EPERM',
  'EINVAL',
])

function validationError() {
  const error = new Error()
  error.code = 'PROFILE_READ_VALIDATION'
  return error
}

function inspectPin(pin) {
  const info = statSync(pin.path, { bigint: true })
  if (!info.isFile() || info.size !== BigInt(pin.bytes)) throw validationError()

  const bytes = readFileSync(pin.path)
  if (bytes.length !== pin.bytes) throw validationError()

  const sha256 = createHash('sha256').update(bytes).digest('hex')
  if (sha256 !== pin.sha256) throw validationError()
  if (info.mtimeNs !== BigInt(pin.mtime_ns)) throw validationError()

  return {
    bytes: String(info.size),
    sha256,
    mtime_ns: String(info.mtimeNs),
  }
}

function verifyHomePatchAbsence(inputs) {
  for (const testCase of inputs.cases) {
    if (existsSync(testCase.homePatchAbsent)) throw validationError()
  }
}

function flattenRows(rows) {
  const flattened = []
  for (const row of rows) {
    flattened.push(row)
    if (row !== null && typeof row === 'object' && row.group && Array.isArray(row.config)) {
      flattened.push(...flattenRows(row.config))
    }
  }
  return flattened
}

function safeFailure(error) {
  const name =
    error !== null &&
    typeof error === 'object' &&
    typeof error.name === 'string' &&
    SAFE_ERROR_NAMES.has(error.name)
      ? error.name
      : 'Unknown'

  const code =
    error !== null &&
    typeof error === 'object' &&
    typeof error.code === 'string' &&
    SAFE_ERROR_CODES.has(error.code)
      ? error.code
      : 'UNKNOWN'

  return {
    stage: 'FAILED',
    errorName: name,
    errorCode: code,
  }
}

async function runContract() {
  const inputs = JSON.parse(readFileSync(INPUTS_PATH, 'utf8'))
  assert.deepStrictEqual(inputs, EXPECTED_INPUTS)

  const inputPins = inputs.cases.flatMap(testCase => testCase.pins)
  assert.equal(inputPins.length, 6)
  assert.equal(inputs.primary.length, 4)

  let inputPinsBefore
  let primaryPinsBefore
  let operationError
  let cases

  try {
    inputPinsBefore = inputPins.map(inspectPin)
    primaryPinsBefore = inputs.primary.map(inspectPin)
    verifyHomePatchAbsence(inputs)

    const appBootPin = inputs.primary[0]
    const appBoot = await import(pathToFileURL(appBootPin.path).href)

    if (
      typeof appBoot.loadProfileDirectory !== 'function' ||
      typeof appBoot.readProfilePatches !== 'function' ||
      typeof appBoot.composeEntries !== 'function'
    ) {
      throw validationError()
    }

    cases = []
    for (const testCase of inputs.cases) {
      const stages = {
        load: 'PENDING',
        read: 'PENDING',
        compose: 'PENDING',
      }

      const loaded = appBoot.loadProfileDirectory(
        'dsh',
        testCase.profile,
        testCase.installAnchor,
        { userLayer: false },
      )
      stages.load = 'PASS'

      if (
        loaded === null ||
        typeof loaded !== 'object' ||
        !Array.isArray(loaded.layers) ||
        !Array.isArray(loaded.skippedBundles)
      ) {
        throw validationError()
      }
      if (loaded.layers.length !== 3 || loaded.skippedBundles.length !== 0) {
        throw validationError()
      }

      const patches = appBoot.readProfilePatches('dsh', {
        name: 'desktop',
        dir: testCase.profile,
        patchPath: testCase.patchPath,
        home: testCase.home,
        installAnchor: testCase.installAnchor,
        cwd: testCase.profile,
        startedBundles: [],
        overlays: [],
        telemetryDisabledEnv: '1',
      })
      stages.read = 'PASS'
      if (!Array.isArray(patches)) throw validationError()

      const composedEntries = appBoot.composeEntries([patches])
      stages.compose = 'PASS'
      if (!Array.isArray(composedEntries)) throw validationError()

      const targetRows = flattenRows(composedEntries).filter(
        row => row !== null && typeof row === 'object' && row.id === inputs.targetNamespace,
      )
      if (targetRows.length !== 1) throw validationError()

      const targetRow = targetRows[0]
      if (typeof targetRow.disabled !== 'boolean') throw validationError()

      const targetConfigProvidersExternal =
        targetRow.config !== null &&
        typeof targetRow.config === 'object' &&
        targetRow.config.providers !== null &&
        typeof targetRow.config.providers === 'object' &&
        typeof targetRow.config.providers.external === 'boolean'
          ? targetRow.config.providers.external
          : undefined
      if (typeof targetConfigProvidersExternal !== 'boolean') throw validationError()

      cases.push({
        label: `label${testCase.label}`,
        stage: 'COMPOSE_OK',
        stages,
        layers: loaded.layers.length,
        skipped: loaded.skippedBundles.length,
        patches: patches.length,
        composed: composedEntries.length,
        targetNamespaceCount: targetRows.length,
        targetRowDisabled: targetRow.disabled,
        targetConfigProvidersExternal,
      })
    }
  } catch (error) {
    operationError = error
  }

  let pinError
  if (inputPinsBefore !== undefined && primaryPinsBefore !== undefined) {
    try {
      const inputPinsAfter = inputPins.map(inspectPin)
      const primaryPinsAfter = inputs.primary.map(inspectPin)
      verifyHomePatchAbsence(inputs)
      assert.deepStrictEqual(inputPinsAfter, inputPinsBefore)
      assert.deepStrictEqual(primaryPinsAfter, primaryPinsBefore)
    } catch (error) {
      pinError = error
    }
  }

  if (operationError !== undefined) throw operationError
  if (pinError !== undefined) throw pinError

  assert.equal(cases.length, 3)
  for (const result of cases) {
    assert.equal(result.stage, 'COMPOSE_OK')
    assert.deepStrictEqual(result.stages, {
      load: 'PASS',
      read: 'PASS',
      compose: 'PASS',
    })
    assert.equal(result.layers, 3)
    assert.equal(result.skipped, 0)
    assert.equal(result.targetNamespaceCount, 1)
  }

  return {
    stage: 'PASS',
    cases,
  }
}

try {
  const output = await runContract()
  console.log(JSON.stringify(output))
} catch (error) {
  console.log(JSON.stringify(safeFailure(error)))
  process.exitCode = 1
}
