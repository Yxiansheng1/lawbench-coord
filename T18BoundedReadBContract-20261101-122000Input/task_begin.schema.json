{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/core/task_begin.schema.json",
  "title": "POST /core/task/begin",
  "description": "Agent 插件在每轮第一步调用：由会话头 cwd 找到案件，按该会话当前的选择（待执行的任务单，不消耗、不删除）新建一个执行中的任务；带 request_id 时，服务必须原子 claim 该 R 已准备的材料批次并把 scope 固化到任务；同一 R 重放返回同一任务和 scope，不同会话/案件或不同材料集合不得挪用。没有 request_id 的旧调用仍按全案运行",
  "$defs": {
    "request_scope": {
      "type": "object",
      "description": "任务开始时由服务原子 claim 并固定的本批材料快照。身份键是 DSH 原生 request_id；后续 context、list/search/read、wiki 与 cache 只能按 task_id 读取这份快照，不能由模型参数或界面提示放宽到全案",
      "properties": {
        "request_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/request_id"
        },
        "case_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
        },
        "kind": {
          "const": "materials"
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "material_id": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
              },
              "sha256": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/sha256"
              }
            },
            "additionalProperties": false,
            "required": [
              "material_id",
              "sha256"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "case_id",
        "kind",
        "materials"
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/session_id"
        },
        "cwd": {
          "type": "string",
          "description": "会话头的 cwd，原样传入；服务只用它查注册表"
        },
        "request_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/request_id"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_id",
        "cwd"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {
                "task_id": {
                  "$ref": "lawbench://contracts/common.schema.json#/$defs/task_id"
                },
                "case_id": {
                  "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
                },
                "skill": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "params": {
                  "$ref": "lawbench://contracts/common.schema.json#/$defs/params"
                },
                "budget": {
                  "$ref": "lawbench://contracts/common.schema.json#/$defs/budget"
                },
                "route": {
                  "enum": [
                    "local",
                    "external"
                  ],
                  "description": "T38：会话选择的任务路由快照；旧响应缺省按 local"
              },
              "request_id": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/request_id"
              },
              "request_scope": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/request_scope"
                  },
                  {
                    "type": "null"
                  }
                ]
                }
              },
              "additionalProperties": false,
              "required": [
                "task_id",
                "case_id",
                "skill",
                "params",
                "budget"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/task_id"
        },
        "case_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
        },
        "skill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "params": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/params"
        },
        "budget": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/budget"
        },
        "route": {
          "enum": [
            "local",
            "external"
          ],
          "description": "T38：会话选择的任务路由快照；旧响应缺省按 local"
              },
              "request_id": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/request_id"
              },
              "request_scope": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/request_scope"
                  },
                  {
                    "type": "null"
                  }
                ]
        }
      },
      "additionalProperties": false,
      "required": [
        "task_id",
        "case_id",
        "skill",
        "params",
        "budget"
      ]
    }
  }
}
