{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/request_scope.schema.json",
  "title": "POST /api/request/scope",
  "description": "按 DSH 原生 request_id 准备或释放下一条消息的材料批次（1.6/T31）。prepare 只绑定准备快照，不触发模型；release 用于 prompt 失败或取消，不影响材料本身。同一元组幂等；同 session+request 改案、改材料或跨会话重放一律冲突，task/begin 首次 claim 后固定，后续 queue/attempt/retry 只能沿用该任务快照",
  "$defs": {
    "request": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "prepare"
            },
            "case_id": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
            },
            "session_id": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/session_id"
            },
            "request_id": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/request_id"
            },
            "material_ids": {
              "type": "array",
              "items": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "case_id",
            "session_id",
            "request_id",
            "material_ids"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "release"
            },
            "case_id": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
            },
            "session_id": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/session_id"
            },
            "request_id": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/request_id"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "case_id",
            "session_id",
            "request_id"
          ]
        }
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "prepare"
            },
            "request_id": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/request_id"
            },
            "case_id": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
            },
            "session_id": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/session_id"
            },
            "material_ids": {
              "type": "array",
              "items": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "request_id",
            "case_id",
            "session_id",
            "material_ids"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "release"
            },
            "request_id": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/request_id"
            },
            "case_id": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
            },
            "session_id": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/session_id"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "request_id",
            "case_id",
            "session_id"
          ]
        }
      ]
    }
  }
}
