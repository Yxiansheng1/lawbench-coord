{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/files/task.schema.json",
  "title": "工作区/任务/<任务ID>/task.json",
  "description": "任务单（执行前写）",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "task_id": {
      "$ref": "lawbench://contracts/common.schema.json#/$defs/task_id"
    },
    "case_id": {
      "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
    },
    "kind": {
      "enum": [
        "agent",
        "pipeline"
      ]
    },
    "session_id": {
      "anyOf": [
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/session_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "entry": {
      "anyOf": [
        {
          "type": "string",
          "description": "胶囊 id"
        },
        {
          "type": "null"
        }
      ]
    },
    "skill": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "step": {
      "anyOf": [
        {
          "enum": [
            "wiki_build",
            "wiki_update"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "lawbench://contracts/common.schema.json#/$defs/input_ref"
      }
    },
    "params": {
      "$ref": "lawbench://contracts/common.schema.json#/$defs/params"
    },
    "budget": {
      "$ref": "lawbench://contracts/common.schema.json#/$defs/budget"
    },
    "state": {
      "enum": [
        "pending",
        "running",
        "finished",
        "abnormal"
      ],
      "description": "abnormal=打开案件时发现仍为 running（上次硬退出）"
    },
    "created_at": {
      "$ref": "lawbench://contracts/common.schema.json#/$defs/time"
    },
    "request_id": {
      "$ref": "lawbench://contracts/common.schema.json#/$defs/request_id"
    },
    "request_scope": {
      "anyOf": [
        {
          "type": "object",
          "description": "任务开始时由服务原子 claim 并固定的本批材料快照；后续 context、list/search/read、wiki 与 cache 只能按 task_id 读取这份快照",
          "properties": {
            "request_id": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/request_id"
            },
            "case_id": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
            },
            "kind": {
              "const": "materials"
            },
            "materials": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "material_id": {
                    "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
                  },
                  "sha256": {
                    "$ref": "lawbench://contracts/common.schema.json#/$defs/sha256"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "material_id",
                  "sha256"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "required": [
            "request_id",
            "case_id",
            "kind",
            "materials"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "route": {
      "enum": [
        "local",
        "external"
      ],
      "description": "T38：任务路由快照；旧任务缺省按 local，不驱动流水线"
    }
  },
  "additionalProperties": false,
  "required": [
    "v",
    "task_id",
    "case_id",
    "kind",
    "session_id",
    "entry",
    "skill",
    "step",
    "inputs",
    "params",
    "budget",
    "state",
    "created_at"
  ]
}
