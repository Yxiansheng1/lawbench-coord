+def _pdf_page_text(path: pathlib.Path) -> dict[int, str]:
+    text = _plain_text(path)
+    matches = list(re.finditer(r"^【第([0-9]+)页】$", text, re.M))
+    numbers = [int(match.group(1)) for match in matches]
+    if numbers != list(range(1, PDF_EXPECTED_PAGES + 1)):
+        raise Deny("derived_pdf_page_markers")
+    pages: dict[int, str] = {}
+    for index, match in enumerate(matches):
+        end = matches[index + 1].start() if index + 1 < len(matches) else len(text)
+        pages[numbers[index]] = text[match.end():end].strip()
+    if any(not page for page in pages.values()):
+        raise Deny("derived_pdf_empty_page")
+    if any(fragment not in pages[2] for fragment in PDF_PAGE2_FRAGMENTS):
+        raise Deny("derived_pdf_page2_fragments")
+    if PDF_FIRST_PAGE_MARKER in pages[2]:
+        raise Deny("derived_pdf_page2_has_first_page_heading")
+    return pages
+
+
+def _png_identity(value: Any) -> dict[str, int]:
+    if not isinstance(value, str) or not value:
+        raise Deny("source_page_png_missing")
+    if len(value) > ((MAX_CAPTURE + 2) // 3) * 4 + 4:
+        raise Deny("source_page_png_too_large")
+    try:
+        raw = base64.b64decode(value, validate=True)
+    except (ValueError, TypeError):
+        raise Deny("source_page_png_base64") from None
+    if base64.b64encode(raw).decode("ascii") != value:
+        raise Deny("source_page_png_base64")
+    if len(raw) < 33 or raw[:8] != b"\x89PNG\r\n\x1a\n":
+        raise Deny("source_page_png_magic")
+    if raw[8:16] != b"\x00\x00\x00\rIHDR":
+        raise Deny("source_page_png_ihdr")
+    width = int.from_bytes(raw[16:20], "big")
+    height = int.from_bytes(raw[20:24], "big")
+    if width <= 0 or height <= 0 or (width == 1 and height == 1):
+        raise Deny("source_page_png_dimensions")
+    if max(width, height) > 2480:
+        raise Deny("source_page_png_dimensions")
+    return {"bytes": len(raw), "width": width, "height": height}
 
 
